FROM node:24.22.1-bookworm-slim AS deps

WORKDIR /app

# Lockfile-only layer for dependency fetch, independent of package.json changes
COPY pnpm-lock.yaml .npmrc pnpm-workspace.yaml ./

RUN corepack enable \
  && corepack prepare pnpm@10.24.0 --activate \
  && pnpm fetch

FROM deps AS builder-common

WORKDIR /app

COPY ./packages/common ./packages/common

RUN corepack enable \
  && corepack prepare pnpm@10.24.0 --activate \
  && pnpm install --filter @domifa/common... --frozen-lockfile \
  && pnpm --filter @domifa/common build

FROM deps AS builder

WORKDIR /app

COPY --from=builder-common /app/packages/common ./packages/common

COPY ./packages/frontend ./packages/frontend

# Build-once / deploy-many : on NE substitue PLUS les URLs au BUILD. Les placeholders ${DOMIFA_*}
# de environment.prod.ts et index.html survivent dans le bundle compilé et sont substitués AU
# DÉMARRAGE du conteneur, depuis l'env du pod (cf. packages/nginx-runtime-env.sh + ConfigMap du chart).
ARG PRODUCTION

RUN corepack enable \
  && corepack prepare pnpm@10.24.0 --activate \
  && pnpm install --filter @domifa/frontend... --frozen-lockfile \
  && pnpm --filter @domifa/frontend build

FROM ghcr.io/socialgouv/docker/nginx4spa:8.2.4

COPY ./packages/nginx.conf /etc/nginx/nginx.conf
COPY ./packages/frontend/security-headers.conf /etc/nginx/security-headers.conf
COPY --from=builder /app/packages/frontend/dist/domifa/browser /usr/share/nginx/template
# Substitution runtime des placeholders ${DOMIFA_*} puis chaînage de l'entrypoint nginx4spa.
COPY --chmod=0755 ./packages/nginx-runtime-env.sh /nginx-runtime-env.sh
USER 101

ENTRYPOINT ["/nginx-runtime-env.sh"]
