FROM node:24-bookworm-slim AS deps

WORKDIR /app

# Lockfile-only layer for dependency fetch, independent of package.json changes
COPY pnpm-lock.yaml .npmrc pnpm-workspace.yaml ./

RUN corepack enable \
  && corepack prepare pnpm@10.24.0 --activate \
  && pnpm fetch

FROM deps AS builder-common

WORKDIR /app

COPY ./packages/common ./packages/common

RUN corepack enable \
  && corepack prepare pnpm@10.24.0 --activate \
  && pnpm install --filter @domifa/common... --frozen-lockfile --offline \
  && pnpm --filter @domifa/common build

FROM deps AS builder

WORKDIR /app

COPY --from=builder-common /app/packages/common ./packages/common

COPY ./packages/portail-usagers ./packages/portail-usagers

# Build-once / deploy-many : plus de substitution au BUILD. Les placeholders ${DOMIFA_*} survivent
# dans le bundle et sont substitués au démarrage (cf. packages/nginx-runtime-env.sh + ConfigMap chart).

RUN corepack enable \
  && corepack prepare pnpm@10.24.0 --activate \
  && pnpm install --filter @domifa/portail-usagers... --frozen-lockfile --offline \
  && pnpm --filter @domifa/portail-usagers build

FROM ghcr.io/socialgouv/docker/nginx4spa:8.2.4

COPY ./packages/nginx.conf /etc/nginx/nginx.conf
COPY ./packages/portail-usagers/security-headers.conf /etc/nginx/security-headers.conf
COPY --from=builder /app/packages/portail-usagers/dist/domifa-portail-usagers/browser /usr/share/nginx/template
# Substitution runtime des placeholders ${DOMIFA_*} puis chaînage de l'entrypoint nginx4spa.
COPY --chmod=0755 ./packages/nginx-runtime-env.sh /nginx-runtime-env.sh
USER 101

ENTRYPOINT ["/nginx-runtime-env.sh"]
